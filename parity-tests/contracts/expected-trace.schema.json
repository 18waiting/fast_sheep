{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExpectedTrace",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "sequence",
      "component",
      "operation"
    ],
    "properties": {
      "sequence": {
        "type": "integer",
        "minimum": 1
      },
      "component": {
        "type": "string"
      },
      "operation": {
        "type": "string"
      },
      "state_before": {
        "type": "object"
      },
      "state_after": {
        "type": "object"
      },
      "decision": {
        "type": "object"
      },
      "correlation_id": {
        "type": "string"
      },
      "virtual_time_ms": {
        "type": "integer",
        "minimum": 0
      },
      "metadata": {
        "type": "object"
      }
    }
  }
}