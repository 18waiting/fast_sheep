{
  "name": "fastwork-rebuild",
  "version": "0.0.0",
  "private": true,
  "description": "快羊客服 / fast_sheep - clean-room replica of FastWork (言店长) 6.1008.4; PDD-only MVP.",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:contracts": "pnpm --filter @fastwork/contracts run build && node tests/contracts/contract-schemas.test.mjs",
    "test:python": "node scripts/run-python.mjs -m unittest discover -s services/ai-worker/tests -p \"test_*.py\"",
    "compileall": "node scripts/run-python.mjs -m compileall -q services/ai-worker/src",
    "verify:platform": "node scripts/verify-platform-native-view-isolation.mjs",
    "scan:secrets": "node scripts/scan-sensitive-values.mjs",
    "check:boundary": "node scripts/check-clean-room-boundary.mjs",
    "start": "pnpm --filter @fastwork/desktop run start",
    "verify": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run test:contracts && pnpm run test:python && pnpm run compileall && pnpm run scan:secrets && pnpm run check:boundary && pnpm run verify:platform"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "tsx": "^4.23.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
