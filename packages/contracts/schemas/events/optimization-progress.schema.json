{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:event:optimization-progress",
  "$title": "Event optimization-progress",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "payload"
  ],
  "properties": {
    "event": {
      "const": "optimization-progress"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "job_id": {
          "type": "string"
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "job_id"
      ]
    },
    "correlation_id": {
      "type": "string"
    }
  }
}