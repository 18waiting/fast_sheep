{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:event:conversation-state-changed",
  "$title": "Event conversation-state-changed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "payload"
  ],
  "properties": {
    "event": {
      "const": "conversation-state-changed"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "conversation_id",
        "state"
      ]
    },
    "correlation_id": {
      "type": "string"
    }
  }
}