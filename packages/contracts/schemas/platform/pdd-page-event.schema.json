{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:platform:pdd-page-event",
  "$title": "PddPageEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["event", "session_id"],
  "properties": {
    "event": { "type": "string" },
    "session_id": { "type": "string", "minLength": 1 },
    "document_generation": { "type": "integer", "minimum": 1 },
    "shop_id": { "type": "string" },
    "conversation_id": { "type": "string" },
    "buyer_id": { "type": "string" },
    "buyer": { "type": "string" },
    "platform_message_id": { "type": "string" },
    "message_type": { "type": "string" },
    "direction": { "type": "string", "enum": ["inbound", "outbound"] },
    "content": { "type": "string" },
    "timestamp": { "type": "string" },
    "command_id": { "type": "string" },
    "ok": { "type": "boolean" },
    "reason": { "type": "string" },
    "status": { "type": "string" },
    "customer_uid": { "type": "string", "minLength": 1 },
    "error": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "event": { "const": "message_received" } } },
      "then": { "required": ["shop_id", "conversation_id", "direction", "content"] }
    },
    {
      "if": { "properties": { "event": { "const": "conversation_changed" } } },
      "then": { "required": ["shop_id", "conversation_id"] }
    },
    {
      "if": { "properties": { "event": { "const": "send_ack" } } },
      "then": { "required": ["shop_id", "conversation_id", "command_id", "ok"] }
    },
    {
      "if": { "properties": { "event": { "const": "transfer_ack" } } },
      "then": { "required": ["shop_id", "conversation_id", "command_id", "ok"] }
    },
    {
      "if": { "properties": { "event": { "const": "selected_customer_observed" } } },
      "then": {
        "required": ["shop_id", "status"],
        "properties": {
          "status": { "enum": ["SELECTED", "NONE", "UNKNOWN"] }
        },
        "oneOf": [
          { "required": ["customer_uid"], "properties": { "status": { "const": "SELECTED" } } },
          { "not": { "required": ["customer_uid"] }, "properties": { "status": { "enum": ["NONE", "UNKNOWN"] } } }
        ]
      }
    }
  ]
}
