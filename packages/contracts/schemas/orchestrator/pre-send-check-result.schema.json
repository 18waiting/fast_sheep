{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:orchestrator:pre-send-check-result",
  "$title": "PreSendCheckResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "SEND_CURRENT",
        "REGENERATE",
        "ABORT_STALE"
      ]
    },
    "generation": {
      "type": "integer"
    },
    "reason": {
      "type": "string"
    }
  }
}
