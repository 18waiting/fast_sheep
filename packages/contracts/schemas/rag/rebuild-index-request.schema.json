{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:rag:rebuild-index-request",
  "$title": "RebuildIndexRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "full",
        "incremental",
        "precise_delete"
      ]
    },
    "entry_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "for precise_delete"
    },
    "product_id": {
      "type": "string",
      "description": "for incremental product-scoped refresh"
    }
  }
}
