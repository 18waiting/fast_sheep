{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:config:rag-config",
  "$title": "RAGConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "embedding_dim",
    "metric"
  ],
  "properties": {
    "embedding_dim": {
      "type": "integer",
      "const": 1024,
      "description": "drift-corrected"
    },
    "metric": {
      "type": "string",
      "const": "cosine"
    },
    "product_search_top_k": {
      "type": "integer",
      "default": 15
    },
    "product_quality_threshold": {
      "type": "number",
      "default": 0.6
    },
    "product_fast_return_threshold": {
      "type": "number",
      "default": 0.9
    },
    "completed_fast_return_sim": {
      "type": "number",
      "default": 0.9
    },
    "completed_fast_return_len_diff": {
      "type": "integer",
      "default": 3
    },
    "rerank_high_similarity_skip": {
      "type": "number",
      "default": 0.85
    },
    "rerank_skip_candidate_count": {
      "type": "integer",
      "default": 3
    },
    "rerank_candidate_limit": {
      "type": "integer"
    },
    "similarity_weight": {
      "type": "number",
      "default": 0.4
    },
    "rerank_weight": {
      "type": "number",
      "default": 0.6
    },
    "raw_protection_threshold": {
      "type": "number",
      "default": 0.7
    },
    "low_rerank_penalty": {
      "type": "number",
      "default": 0.1
    },
    "composite_clamp": {
      "type": "number",
      "default": 1
    },
    "reference_top_n": {
      "type": "integer",
      "default": 10
    },
    "product_isolation": {
      "type": "boolean",
      "default": false,
      "description": "DESIGN: 知识库商品隔离启用 -> disable global fill"
    },
    "fast_return_enabled": {
      "type": "boolean",
      "default": true,
      "description": "DESIGN: 知识库秒回启用"
    },
    "index_cache_size": {
      "type": "integer",
      "minimum": 1,
      "default": 16,
      "description": "DESIGN: max cached product indexes"
    },
    "build_batch_size": {
      "type": "integer",
      "minimum": 1,
      "default": 64,
      "description": "DESIGN: embedding batch size"
    },
    "derived_root": {
      "type": "string",
      "description": "DESIGN: derived index root (default <DATA_ROOT>/derived/rag)"
    },
    "global_search_multiplier": {
      "type": "integer",
      "minimum": 1,
      "default": 2,
      "description": "DESIGN: global search returns top_k*2 (observed 返回数量*2)"
    },
    "min_search_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.02,
      "description": "DESIGN: global/vector search minimum score (observed 0.02)"
    },
    "rerank_document_max_chars": {
      "type": "integer",
      "minimum": 1,
      "default": 500,
      "description": "DESIGN: rerank document composition cap (observed <=500 chars)"
    }
  }
}
