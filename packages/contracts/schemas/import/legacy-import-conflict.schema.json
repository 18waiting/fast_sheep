{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:import:legacy-import-conflict",
  "$title": "LegacyImportConflict",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "identity",
    "reason",
    "policy"
  ],
  "properties": {
    "item_id": {
      "type": "string"
    },
    "identity": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "policy": {
      "type": "string",
      "enum": [
        "PRESERVE_EXISTING",
        "INSERT_MISSING",
        "MERGE_SAFE_FIELDS",
        "REPLACE_SELECTED"
      ]
    }
  }
}
