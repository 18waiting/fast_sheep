{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:import:legacy-import-status",
  "$title": "LegacyImportStatus",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "session_id",
    "state"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "backup_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
