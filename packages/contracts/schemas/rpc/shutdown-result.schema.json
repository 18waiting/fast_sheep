{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:rpc:shutdown-result",
  "$title": "ShutdownResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "exit_code"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "exit_code": {
      "type": "integer"
    },
    "reason": {
      "type": "string"
    }
  }
}
