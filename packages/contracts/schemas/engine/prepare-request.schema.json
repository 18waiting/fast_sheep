{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:engine:prepare-request",
  "$title": "PrepareRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query"
  ],
  "properties": {
    "query": {
      "type": "string"
    },
    "order_state": {
      "type": "string",
      "enum": [
        "未下单",
        "已下单"
      ]
    },
    "product_id": {
      "type": "string"
    },
    "product_info": {
      "type": "string"
    },
    "history": {
      "type": "string"
    },
    "reference_content": {
      "type": "string"
    },
    "daily_count": {
      "type": "integer",
      "minimum": 0
    },
    "points": {
      "type": "integer",
      "minimum": 0
    },
    "mode": {
      "type": "string"
    }
  }
}
