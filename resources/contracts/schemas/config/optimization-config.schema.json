{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:config:optimization-config",
  "$title": "OptimizationConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "cooldown_seconds": {
      "type": "integer",
      "default": 3600
    },
    "cooldown_purge_seconds": {
      "type": "integer",
      "default": 86400
    },
    "dirty_length_limit": {
      "type": "integer",
      "default": 20000
    },
    "min_qa_threshold": {
      "type": "integer",
      "default": 20
    }
  }
}