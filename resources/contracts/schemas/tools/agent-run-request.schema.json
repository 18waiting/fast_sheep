{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:tools:agent-run-request",
  "$title": "AgentRunRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messages"
  ],
  "properties": {
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "max_rounds": {
      "type": "integer",
      "minimum": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
