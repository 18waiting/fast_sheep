{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:domain:prompt-profile",
  "$title": "PromptProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "content"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "<PROMPT_CONTENT> placeholder"
    },
    "order_status_binding": {
      "type": "string",
      "enum": [
        "未下单",
        "已下单",
        "all"
      ]
    },
    "mounted_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}