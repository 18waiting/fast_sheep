{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:domain:generation-request",
  "$title": "GenerationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "messages"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "provider_ref": {
      "type": "string"
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "temperature": {
      "type": "number"
    },
    "thinking": {
      "type": "boolean",
      "default": false
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 0
    },
    "cancellation_token": {
      "type": "string"
    }
  }
}