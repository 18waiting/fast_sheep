{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:domain:knowledge-entry",
  "$title": "KnowledgeEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "question",
    "answer",
    "product_id",
    "trust_level",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "entry_id content hash"
    },
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "product_id": {
      "type": "string",
      "description": "''=无商品ID, '1'=通用"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string"
    },
    "trust_level": {
      "$ref": "fastwork:common:trust-level"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "description": "Embedding/index data is NOT part of the authoritative KnowledgeEntry (derived artifacts)."
}