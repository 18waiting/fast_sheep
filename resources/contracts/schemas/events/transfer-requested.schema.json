{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:event:transfer-requested",
  "$title": "Event transfer-requested",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "payload"
  ],
  "properties": {
    "event": {
      "const": "transfer-requested"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "conversation_id",
        "target"
      ]
    },
    "correlation_id": {
      "type": "string"
    }
  }
}