{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:rpc:event",
  "$title": "RpcEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "payload"
  ],
  "properties": {
    "event": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "correlation_id": {
      "type": "string"
    }
  }
}