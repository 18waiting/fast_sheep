{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:rpc:request",
  "$title": "RpcRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "request_id",
    "method",
    "payload"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "WORKER_RPC_VERSION"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "description": "method-specific; validated by method schema"
    },
    "context": {
      "$ref": "fastwork:rpc:context"
    },
    "cancellation_token": {
      "type": "string"
    }
  }
}