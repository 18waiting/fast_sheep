{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:rpc:response",
  "$title": "RpcResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "ok",
    "result",
    "error"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "result": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ],
      "description": "null when ok=false"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "fastwork:error"
        },
        {
          "type": "null"
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}