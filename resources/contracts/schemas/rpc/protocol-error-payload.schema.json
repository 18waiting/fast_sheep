{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:rpc:protocol-error-payload",
  "$title": "ProtocolErrorPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reason"
  ],
  "properties": {
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string"
    },
    "frame_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "max_frame_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "correlation_id": {
      "type": "string"
    }
  }
}
