{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastwork:import:legacy-import-apply-result",
  "$title": "LegacyImportApplyResult",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "session_id",
    "state"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "backup_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "main_inserted": {
      "type": "integer"
    },
    "worker_inserted": {
      "type": "integer"
    },
    "duplicates": {
      "type": "integer"
    },
    "verification": {
      "type": "object"
    }
  }
}
